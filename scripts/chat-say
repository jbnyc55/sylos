#!/usr/bin/env bash
#
# chat-say — Syla's reply into the owner's Syla conversation, over HTTPS.
#
# The thread's receipt: calls the syla_chat_say RPC, which switches to the
# `claude` role and inserts the message (author 'syla') into the chats row
# with kind = 'syla', optionally linked to the run it answers.
#
# Usage:
#   scripts/chat-say --body "<the message>" [--run <run-uuid>]
#
# Flags: --body required; --run links the message to a syla_job_runs row.
#
# Environment (all required; see notes/03-agent-access.md):
#   SUPABASE_URL, SUPABASE_ANON_KEY, CLAUDE_RQ_KEY

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

body='' run=''
while [ $# -gt 0 ]; do
    case "$1" in
        --body) body="${2:?}"; shift 2 ;;
        --run)  run="${2:?}"; shift 2 ;;
        -h|--help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
        *) die "unknown flag: $1" ;;
    esac
done

[ -n "$body" ] || die "--body is required"

for v in SUPABASE_URL SUPABASE_ANON_KEY CLAUDE_RQ_KEY; do
    [ -n "${!v:-}" ] || die "$v is not set — see notes/03-agent-access.md"
done

payload=$(jq -n --arg body "$body" --arg run "$run" '
    {_body: $body}
    + (if $run != "" then {_run_id: $run} else {} end)')

if resp=$(curl -sS --fail-with-body \
    -X POST "${SUPABASE_URL%/}/rest/v1/rpc/syla_chat_say" \
    -H "apikey: ${SUPABASE_ANON_KEY}" \
    -H "x-claude-rq-key: ${CLAUDE_RQ_KEY}" \
    -H "content-type: application/json" \
    --data "$payload"); then
    printf '%s\n' "$resp" | jq .
else
    status=$?
    printf '%s\n' "$resp" | jq . 2>/dev/null || printf '%s\n' "$resp" >&2
    exit "$status"
fi

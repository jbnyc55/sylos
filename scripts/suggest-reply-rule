#!/usr/bin/env bash
#
# suggest-reply-rule — file one pending reply-rule suggestion, over HTTPS.
#
# Calls the suggest_reply_rule RPC, which switches to the `claude` role and
# inserts a status 'suggested' reply_rules row the owner accepts, parks or
# deletes in the app. Capped at one pending suggestion per connection. A
# rule that needs an integration you don't have names its slug — the app's
# card then wears the connect flow.
#
# Usage:
#   scripts/suggest-reply-rule --follower <follower-uuid> \
#       --verdict reply|dont_reply --body "<the sentence>" \
#       [--rationale "<the why>"] [--needs-integration <slug>]
#
# Flags: --follower, --verdict and --body required.
#
# Environment (all required; see notes/03-agent-access.md):
#   SUPABASE_URL, SUPABASE_ANON_KEY, CLAUDE_RQ_KEY

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

follower='' verdict='' body='' rationale='' needs=''
while [ $# -gt 0 ]; do
    case "$1" in
        --follower)          follower="${2:?}"; shift 2 ;;
        --verdict)           verdict="${2:?}"; shift 2 ;;
        --body)              body="${2:?}"; shift 2 ;;
        --rationale)         rationale="${2:?}"; shift 2 ;;
        --needs-integration) needs="${2:?}"; shift 2 ;;
        -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
        *) die "unknown flag: $1" ;;
    esac
done

[ -n "$follower" ] && [ -n "$verdict" ] && [ -n "$body" ] \
    || die "--follower, --verdict and --body are required"

for v in SUPABASE_URL SUPABASE_ANON_KEY CLAUDE_RQ_KEY; do
    [ -n "${!v:-}" ] || die "$v is not set — see notes/03-agent-access.md"
done

payload=$(jq -n --arg follower "$follower" --arg verdict "$verdict" \
             --arg body "$body" --arg rationale "$rationale" --arg needs "$needs" '
    {_follower_id: $follower, _verdict: $verdict, _body: $body}
    + (if $rationale != "" then {_rationale: $rationale} else {} end)
    + (if $needs != "" then {_needs_integration: $needs} else {} end)')

if resp=$(curl -sS --fail-with-body \
    -X POST "${SUPABASE_URL%/}/rest/v1/rpc/suggest_reply_rule" \
    -H "apikey: ${SUPABASE_ANON_KEY}" \
    -H "x-claude-rq-key: ${CLAUDE_RQ_KEY}" \
    -H "content-type: application/json" \
    --data "$payload"); then
    printf '%s\n' "$resp" | jq .
else
    status=$?
    printf '%s\n' "$resp" | jq . 2>/dev/null || printf '%s\n' "$resp" >&2
    exit "$status"
fi

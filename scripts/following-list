#!/usr/bin/env bash
#
# following-list — the names of your owner's following, and nothing else.
#
# A follow is a friend's Sylos database your owner holds a key to
# (skills/following). This is how you find the friend a message names:
# it answers the names alone — no address, no key — and the other
# follow scripts take any of them (case doesn't matter).
#
# Usage:
#   scripts/following-list
#
# Environment (all required — the same trio scripts/rq uses):
#   SUPABASE_URL        https://<project-ref>.supabase.co
#   SUPABASE_ANON_KEY   the anon / publishable key (client-public)
#   CLAUDE_RQ_KEY       matches Vault secret claude_rq_key

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
fi

for v in SUPABASE_URL SUPABASE_ANON_KEY CLAUDE_RQ_KEY; do
    [ -n "${!v:-}" ] || die "$v is not set — see notes/03-agent-access.md"
done

if resp=$(curl -sS --fail-with-body \
    -X POST "${SUPABASE_URL%/}/rest/v1/rpc/following_names" \
    -H "apikey: ${SUPABASE_ANON_KEY}" \
    -H "x-claude-rq-key: ${CLAUDE_RQ_KEY}" \
    -H "content-type: application/json" \
    --data '{}'); then
    printf '%s\n' "$resp" | jq .
else
    status=$?
    printf '%s\n' "$resp" | jq . 2>/dev/null || printf '%s\n' "$resp" >&2
    exit "$status"
fi

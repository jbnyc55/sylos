#!/usr/bin/env bash
#
# follower-edit — propose a change to the owner, or read your outcomes.
#
# The third kind of follower request: where follower-rq reads with SQL and
# follower-prompt queues a question, this queues a free-text edit proposal
# through the follower_submit_edit RPC. Nothing is written by you — the owner
# applies or declines each proposal personally, optionally with a note.
# One of your silos must have "propose edits" toggled on.
#
# Usage:
#   scripts/follower-edit "my phone number changed to 555-0100"
#   scripts/follower-edit -                 # stdin form for longer proposals
#   scripts/follower-edit --list            # your proposals, newest first
#
# Environment (all required):
#   SUPABASE_URL        https://<project-ref>.supabase.co
#   SUPABASE_ANON_KEY   the anon / publishable key (client-public)
#   FOLLOWER_TOKEN        the personal key from the app's Follower access page
#                       (GUEST_TOKEN still honored as a fallback name)

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

if [ $# -lt 1 ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
fi

FOLLOWER_TOKEN="${FOLLOWER_TOKEN:-${GUEST_TOKEN:-}}"
for v in SUPABASE_URL SUPABASE_ANON_KEY FOLLOWER_TOKEN; do
    [ -n "${!v:-}" ] || die "$v is not set"
done

post() { # $1 = rpc name, $2 = json body
    local resp status
    if resp=$(curl -sS --fail-with-body \
        -X POST "${SUPABASE_URL%/}/rest/v1/rpc/$1" \
        -H "apikey: ${SUPABASE_ANON_KEY}" \
        -H "content-type: application/json" \
        --data "$2"); then
        printf '%s\n' "$resp" | jq .
    else
        status=$?
        printf '%s\n' "$resp" | jq . 2>/dev/null || printf '%s\n' "$resp" >&2
        exit "$status"
    fi
}

if [ "$1" = "--list" ]; then
    q="select id, proposal, status, response, created_at, resolved_at
       from follower_edit_requests order by created_at desc"
    post follower_rq "$(jq -n --arg token "$FOLLOWER_TOKEN" --arg q "$q" '{_token: $token, q: $q}')"
    exit 0
fi

if [ "$1" = "-" ]; then proposal=$(cat); else proposal="$*"; fi
[ -n "$(printf '%s' "$proposal" | tr -d '[:space:]')" ] || die "empty proposal"

post follower_submit_edit \
    "$(jq -n --arg token "$FOLLOWER_TOKEN" --arg p "$proposal" '{_token: $token, _proposal: $p}')"

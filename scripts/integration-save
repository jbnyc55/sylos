#!/usr/bin/env bash
#
# integration-save — register or update a web integration in the app.
#
# Calls the save_integration RPC, which upserts one public.integrations
# row — the registry the app's Integrations page renders. The row names an
# edge function slug the app drives through the conventional routes
# (/status, /connect, /sync, /disconnect); for kind oauth_pkce the config
# JSON describes the consent flow (auth_url, client_id, scope,
# callback_scheme, redirect_uri, optional extra_params). See
# notes/06-integrations.md for the whole contract.
#
# Usage:
#   scripts/integration-save --slug gcal --title "Google Calendar" \
#       [--blurb "One line for the list"] [--kind oauth_pkce] \
#       [--config-file config.json | --config '{"auth_url": ...}'] [--sort 0]
#
# Environment (all required; see notes/03-agent-access.md):
#   SUPABASE_URL, SUPABASE_ANON_KEY, CLAUDE_RQ_KEY

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

slug='' title='' blurb='' kind='oauth_pkce' config='{}' sort='0'
while [ $# -gt 0 ]; do
    case "$1" in
        --slug)        slug="${2:?}"; shift 2 ;;
        --title)       title="${2:?}"; shift 2 ;;
        --blurb)       blurb="${2:?}"; shift 2 ;;
        --kind)        kind="${2:?}"; shift 2 ;;
        --config)      config="${2:?}"; shift 2 ;;
        --config-file) config=$(cat "${2:?}"); shift 2 ;;
        --sort)        sort="${2:?}"; shift 2 ;;
        -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
        *) die "unknown flag: $1" ;;
    esac
done

[ -n "$slug" ] && [ -n "$title" ] || die "--slug and --title are required"
printf '%s' "$config" | jq -e 'type == "object"' >/dev/null \
    || die "--config must be a JSON object"

for v in SUPABASE_URL SUPABASE_ANON_KEY CLAUDE_RQ_KEY; do
    [ -n "${!v:-}" ] || die "$v is not set — see notes/03-agent-access.md"
done

body=$(jq -n --arg slug "$slug" --arg title "$title" --arg blurb "$blurb" \
             --arg kind "$kind" --argjson config "$config" --argjson sort "$sort" \
             '{_slug: $slug, _title: $title, _blurb: $blurb, _kind: $kind, _config: $config, _sort: $sort}')

if resp=$(curl -sS --fail-with-body \
    -X POST "${SUPABASE_URL%/}/rest/v1/rpc/save_integration" \
    -H "apikey: ${SUPABASE_ANON_KEY}" \
    -H "x-claude-rq-key: ${CLAUDE_RQ_KEY}" \
    -H "content-type: application/json" \
    --data "$body"); then
    printf '%s\n' "$resp" | jq .
else
    status=$?
    printf '%s\n' "$resp" | jq . 2>/dev/null || printf '%s\n' "$resp" >&2
    exit "$status"
fi

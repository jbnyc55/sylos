#!/usr/bin/env bash
#
# syla-finish — mark one claimed Syla job run done or failed, over HTTPS.
#
# Calls the finish_syla_run RPC, which switches to the `claude` role and
# closes one 'running' syla_job_runs row with a short summary the owner
# reads in the app's Syla jobs tab.
#
# Usage:
#   scripts/syla-finish --run <run-uuid> --status done   --summary "<text>"
#   scripts/syla-finish --run <run-uuid> --status failed --summary "<why>"
#
# Flags: all required. --status is done or failed; --summary is one or two
# sentences, 2000 characters at most.
#
# Environment (all required; see notes/07-agent-rq-https.md):
#   SUPABASE_URL, SUPABASE_ANON_KEY, CLAUDE_RQ_KEY

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

run='' status='' summary=''
while [ $# -gt 0 ]; do
    case "$1" in
        --run)     run="${2:?}"; shift 2 ;;
        --status)  status="${2:?}"; shift 2 ;;
        --summary) summary="${2:?}"; shift 2 ;;
        -h|--help) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
        *) die "unknown flag: $1" ;;
    esac
done

[ -n "$run" ] && [ -n "$status" ] && [ -n "$summary" ] \
    || die "--run, --status and --summary are required"
case "$status" in done|failed) ;; *) die "--status must be done or failed" ;; esac

for v in SUPABASE_URL SUPABASE_ANON_KEY CLAUDE_RQ_KEY; do
    [ -n "${!v:-}" ] || die "$v is not set — see notes/07-agent-rq-https.md"
done

body=$(jq -n --arg run "$run" --arg status "$status" --arg summary "$summary" \
    '{_run_id: $run, _status: $status, _summary: $summary}')

if resp=$(curl -sS --fail-with-body \
    -X POST "${SUPABASE_URL%/}/rest/v1/rpc/finish_syla_run" \
    -H "apikey: ${SUPABASE_ANON_KEY}" \
    -H "x-claude-rq-key: ${CLAUDE_RQ_KEY}" \
    -H "content-type: application/json" \
    --data "$body"); then
    printf '%s\n' "$resp" | jq .
else
    status=$?
    printf '%s\n' "$resp" | jq . 2>/dev/null || printf '%s\n' "$resp" >&2
    exit "$status"
fi

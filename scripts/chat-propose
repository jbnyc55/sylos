#!/usr/bin/env bash
#
# chat-propose — draft a reply for the owner to approve, over HTTPS.
#
# Calls the propose_chat_reply RPC, which switches to the `claude` role
# and files one pending chat_reply_proposals card for the chat (a newer
# draft supersedes the older). Write the draft in the owner's voice —
# approving sends it as them.
#
# Usage:
#   scripts/chat-propose --chat <chat-uuid> --body "<the draft>" \
#       [--rationale "<the why>"] [--offered-rule <rule-uuid>]
#
# Flags: --chat and --body required; --offered-rule names the suggested
# rule the approval card then offers.
#
# Environment (all required; see notes/03-agent-access.md):
#   SUPABASE_URL, SUPABASE_ANON_KEY, CLAUDE_RQ_KEY

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

chat='' body='' rationale='' offered=''
while [ $# -gt 0 ]; do
    case "$1" in
        --chat)         chat="${2:?}"; shift 2 ;;
        --body)         body="${2:?}"; shift 2 ;;
        --rationale)    rationale="${2:?}"; shift 2 ;;
        --offered-rule) offered="${2:?}"; shift 2 ;;
        -h|--help) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
        *) die "unknown flag: $1" ;;
    esac
done

[ -n "$chat" ] && [ -n "$body" ] || die "--chat and --body are required"

for v in SUPABASE_URL SUPABASE_ANON_KEY CLAUDE_RQ_KEY; do
    [ -n "${!v:-}" ] || die "$v is not set — see notes/03-agent-access.md"
done

payload=$(jq -n --arg chat "$chat" --arg body "$body" \
             --arg rationale "$rationale" --arg offered "$offered" '
    {_chat_id: $chat, _body: $body}
    + (if $rationale != "" then {_rationale: $rationale} else {} end)
    + (if $offered != "" then {_offered_rule_id: $offered} else {} end)')

if resp=$(curl -sS --fail-with-body \
    -X POST "${SUPABASE_URL%/}/rest/v1/rpc/propose_chat_reply" \
    -H "apikey: ${SUPABASE_ANON_KEY}" \
    -H "x-claude-rq-key: ${CLAUDE_RQ_KEY}" \
    -H "content-type: application/json" \
    --data "$payload"); then
    printf '%s\n' "$resp" | jq .
else
    status=$?
    printf '%s\n' "$resp" | jq . 2>/dev/null || printf '%s\n' "$resp" >&2
    exit "$status"
fi

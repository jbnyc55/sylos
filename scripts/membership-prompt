#!/usr/bin/env bash
#
# membership-prompt — queue a prompt at a friend's database, or read your answers.
#
# The syla-to-syla channel: where membership-rq runs SQL directly (for
# what their silos grant), this queues a free-text prompt in THEIR
# member_prompt_requests for their owner — or their Syla, if they
# automate it — to answer in their own time. Poll with --list; pending
# means pending, not failed. Every call goes through your own project's
# membership-relay.
#
# Usage:
#   scripts/membership-prompt alex "can you do dinner on Friday?"
#   scripts/membership-prompt alex -            # stdin form for longer prompts
#   scripts/membership-prompt alex --list       # your requests there, newest first
#
# Environment (all required — the same trio scripts/rq uses):
#   SUPABASE_URL        https://<project-ref>.supabase.co
#   SUPABASE_ANON_KEY   the anon / publishable key (client-public)
#   CLAUDE_RQ_KEY       matches Vault secret claude_rq_key

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

if [ $# -lt 2 ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
fi

for v in SUPABASE_URL SUPABASE_ANON_KEY CLAUDE_RQ_KEY; do
    [ -n "${!v:-}" ] || die "$v is not set — see notes/03-agent-access.md"
done

friend_name="$1"; shift

# Every call goes through YOUR project's membership-relay: it looks the
# friend's credentials up and makes the call — the token never comes here,
# and the session needs no network allowance for the friend's host.
relay() { # $1 = json body
    local resp status
    if resp=$(curl -sS --fail-with-body \
        -X POST "${SUPABASE_URL%/}/functions/v1/membership-relay" \
        -H "apikey: ${SUPABASE_ANON_KEY}" \
        -H "Authorization: Bearer ${SUPABASE_ANON_KEY}" \
        -H "x-claude-rq-key: ${CLAUDE_RQ_KEY}" \
        -H "content-type: application/json" \
        --data "$1"); then
        printf '%s\n' "$resp" | jq .
    else
        status=$?
        printf '%s\n' "$resp" | jq . 2>/dev/null || printf '%s\n' "$resp" >&2
        exit "$status"
    fi
}

if [ "$1" = "--list" ]; then
    q="select id, prompt, status, response, created_at, answered_at from member_prompt_requests order by created_at desc"
    relay "$(jq -n --arg name "$friend_name" --arg q "$q" '{name: $name, kind: "rq", q: $q}')"
    exit 0
fi

if [ "$1" = "-" ]; then prompt=$(cat); else prompt="$*"; fi
[ -n "$(printf '%s' "$prompt" | tr -d '[:space:]')" ] || die "empty prompt"

relay "$(jq -n --arg name "$friend_name" --arg p "$prompt" '{name: $name, kind: "prompt", prompt: $p}')"

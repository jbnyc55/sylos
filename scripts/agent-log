#!/usr/bin/env bash
#
# agent-log — append one row to agent_edits, over HTTPS.
#
# The write half of rq: calls the log_agent_edit RPC, which switches to the
# `claude` role and inserts. The role holds INSERT on agent_edits and nothing
# else, so this is the only write the transport can perform.
#
# Usage:
#   scripts/agent-log --action schema-review --summary "Looked at notes schema"
#   scripts/agent-log --action backfill --target public.notes \
#       --summary "..." --details '{"rows": 42}'
#
# Flags: --action and --summary required; --target, --details (JSON) and
# --agent optional.
#
# Environment (all required; see notes/07-agent-rq-https.md):
#   SUPABASE_URL, SUPABASE_ANON_KEY, CLAUDE_RQ_KEY

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

action='' summary='' target='' details='' agent='claude'
while [ $# -gt 0 ]; do
    case "$1" in
        --action)  action="${2:?}";  shift 2 ;;
        --summary) summary="${2:?}"; shift 2 ;;
        --target)  target="${2:?}";  shift 2 ;;
        --details) details="${2:?}"; shift 2 ;;
        --agent)   agent="${2:?}";   shift 2 ;;
        -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
        *) die "unknown flag: $1" ;;
    esac
done

[ -n "$action" ] && [ -n "$summary" ] || die "--action and --summary are required"

for v in SUPABASE_URL SUPABASE_ANON_KEY CLAUDE_RQ_KEY; do
    [ -n "${!v:-}" ] || die "$v is not set — see notes/07-agent-rq-https.md"
done

body=$(jq -n --arg action "$action" --arg summary "$summary" \
    --arg target "$target" --arg details "$details" --arg agent "$agent" '
    {_action: $action, _summary: $summary, _agent: $agent}
    + (if $target  != "" then {_target: $target} else {} end)
    + (if $details != "" then {_details: ($details | fromjson)} else {} end)') \
    || die "--details must be valid JSON"

if resp=$(curl -sS --fail-with-body \
    -X POST "${SUPABASE_URL%/}/rest/v1/rpc/log_agent_edit" \
    -H "apikey: ${SUPABASE_ANON_KEY}" \
    -H "x-claude-rq-key: ${CLAUDE_RQ_KEY}" \
    -H "content-type: application/json" \
    --data "$body"); then
    printf '%s\n' "$resp" | jq .
else
    status=$?
    printf '%s\n' "$resp" | jq . 2>/dev/null || printf '%s\n' "$resp" >&2
    exit "$status"
fi

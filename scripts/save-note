#!/usr/bin/env bash
#
# save-note — the one-call quick capture, over HTTPS.
#
# Calls the save_note RPC, which switches to the `claude` role and appends
# one raw text item to the owner's chute (source 'syla'). Durable the moment
# it lands; the scheduled Chute sort files it into its real home later, with
# a receipt and undo. The fast path for "this belongs in Sylos" — no doc to
# compose, no path or silo to choose. Editing the docs library stays
# scripts/doc-save's job.
#
# Usage:
#   scripts/save-note --body "Dinner with Maya moved to Friday the 7th"
#   scripts/save-note --body -        # read the note from stdin
#
# Environment (all required; see notes/07-agent-rq-https.md):
#   SUPABASE_URL, SUPABASE_ANON_KEY, CLAUDE_RQ_KEY

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

body=''
while [ $# -gt 0 ]; do
    case "$1" in
        --body) body="${2:?}"; shift 2 ;;
        -h|--help) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
        *) die "unknown flag: $1" ;;
    esac
done

[ -n "$body" ] || die "--body is required"
if [ "$body" = "-" ]; then
    body=$(cat)
    [ -n "$body" ] || die "stdin was empty"
fi

for v in SUPABASE_URL SUPABASE_ANON_KEY CLAUDE_RQ_KEY; do
    [ -n "${!v:-}" ] || die "$v is not set — see notes/07-agent-rq-https.md"
done

payload=$(jq -n --arg body "$body" '{_body: $body}')

if resp=$(curl -sS --fail-with-body \
    -X POST "${SUPABASE_URL%/}/rest/v1/rpc/save_note" \
    -H "apikey: ${SUPABASE_ANON_KEY}" \
    -H "x-claude-rq-key: ${CLAUDE_RQ_KEY}" \
    -H "content-type: application/json" \
    --data "$payload"); then
    printf '%s\n' "$resp" | jq .
else
    status=$?
    printf '%s\n' "$resp" | jq . 2>/dev/null || printf '%s\n' "$resp" >&2
    exit "$status"
fi

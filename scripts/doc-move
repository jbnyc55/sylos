#!/usr/bin/env bash
#
# doc-move — rename one doc's path, over HTTPS.
#
# Calls the move_doc RPC as the `claude` role. One doc per call:
# moving a "folder" is one move per doc under it, each logged and undoable
# on its own. Fails if the destination is taken or the source is missing.
#
# Usage:
#   scripts/doc-move --from <a/b/c> --to <x/y/z>
#
# Flags: both required.
#
# Environment (all required; see notes/07-agent-rq-https.md):
#   SUPABASE_URL, SUPABASE_ANON_KEY, CLAUDE_RQ_KEY

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

from='' to=''
while [ $# -gt 0 ]; do
    case "$1" in
        --from) from="${2:?}"; shift 2 ;;
        --to)   to="${2:?}"; shift 2 ;;
        -h|--help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
        *) die "unknown flag: $1" ;;
    esac
done

[ -n "$from" ] && [ -n "$to" ] || die "--from and --to are required"

for v in SUPABASE_URL SUPABASE_ANON_KEY CLAUDE_RQ_KEY; do
    [ -n "${!v:-}" ] || die "$v is not set — see notes/07-agent-rq-https.md"
done

body=$(jq -n --arg from "$from" --arg to "$to" '{_from: $from, _to: $to}')

if resp=$(curl -sS --fail-with-body \
    -X POST "${SUPABASE_URL%/}/rest/v1/rpc/move_doc" \
    -H "apikey: ${SUPABASE_ANON_KEY}" \
    -H "x-claude-rq-key: ${CLAUDE_RQ_KEY}" \
    -H "content-type: application/json" \
    --data "$body"); then
    printf '%s\n' "$resp" | jq .
else
    status=$?
    printf '%s\n' "$resp" | jq . 2>/dev/null || printf '%s\n' "$resp" >&2
    exit "$status"
fi

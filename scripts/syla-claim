#!/usr/bin/env bash
#
# syla-claim — claim every queued Syla job run, over HTTPS.
#
# Calls the claim_syla_runs RPC, which switches to the `claude` role and
# moves every 'queued' syla_job_runs row to 'running'. Prints a JSON array
# of the claimed runs — run_id, job name, doc_path, doc_title. The doc at
# doc_path holds the job's instructions; read it with scripts/rq. An empty
# array means nothing was waiting.
#
# Usage:
#   scripts/syla-claim
#
# Environment (all required; see notes/07-agent-rq-https.md):
#   SUPABASE_URL, SUPABASE_ANON_KEY, CLAUDE_RQ_KEY

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

case "${1:-}" in
    -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
    '') ;;
    *) die "unknown flag: $1" ;;
esac

for v in SUPABASE_URL SUPABASE_ANON_KEY CLAUDE_RQ_KEY; do
    [ -n "${!v:-}" ] || die "$v is not set — see notes/07-agent-rq-https.md"
done

# SYLA_WORKER (cloud | routine), when the environment names it, stamps
# claimed_by on every claimed run — the recorded fact of where the run
# executed. Unset sends no stamp.
body='{}'
if [ -n "${SYLA_WORKER:-}" ]; then
    body=$(jq -n --arg w "$SYLA_WORKER" '{_worker: $w}')
fi

if resp=$(curl -sS --fail-with-body \
    -X POST "${SUPABASE_URL%/}/rest/v1/rpc/claim_syla_runs" \
    -H "apikey: ${SUPABASE_ANON_KEY}" \
    -H "x-claude-rq-key: ${CLAUDE_RQ_KEY}" \
    -H "content-type: application/json" \
    --data "$body"); then
    printf '%s\n' "$resp" | jq .
else
    status=$?
    printf '%s\n' "$resp" | jq . 2>/dev/null || printf '%s\n' "$resp" >&2
    exit "$status"
fi

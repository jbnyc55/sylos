#!/usr/bin/env bash
#
# chat-auto-reply — one attributed auto-reply into a dm or group, over HTTPS.
#
# Calls the send_auto_reply RPC, which switches to the `claude` role and
# inserts the message (author 'syla', kind 'auto_reply'), citing the active
# REPLY rule that authorizes it. The function refuses anything the cited
# rule's person's reply mode does not allow — the semantic preflight is
# skills/chat-replies; the gate here is structural.
#
# Usage:
#   scripts/chat-auto-reply --chat <chat-uuid> --body "<the reply>" --rule <rule-uuid>
#
# Flags: all three required.
#
# Environment (all required; see notes/03-agent-access.md):
#   SUPABASE_URL, SUPABASE_ANON_KEY, CLAUDE_RQ_KEY

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

chat='' body='' rule=''
while [ $# -gt 0 ]; do
    case "$1" in
        --chat) chat="${2:?}"; shift 2 ;;
        --body) body="${2:?}"; shift 2 ;;
        --rule) rule="${2:?}"; shift 2 ;;
        -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
        *) die "unknown flag: $1" ;;
    esac
done

[ -n "$chat" ] && [ -n "$body" ] && [ -n "$rule" ] || die "--chat, --body and --rule are required"

for v in SUPABASE_URL SUPABASE_ANON_KEY CLAUDE_RQ_KEY; do
    [ -n "${!v:-}" ] || die "$v is not set — see notes/03-agent-access.md"
done

payload=$(jq -n --arg chat "$chat" --arg body "$body" --arg rule "$rule" '
    {_chat_id: $chat, _body: $body, _rule_id: $rule}')

if resp=$(curl -sS --fail-with-body \
    -X POST "${SUPABASE_URL%/}/rest/v1/rpc/send_auto_reply" \
    -H "apikey: ${SUPABASE_ANON_KEY}" \
    -H "x-claude-rq-key: ${CLAUDE_RQ_KEY}" \
    -H "content-type: application/json" \
    --data "$payload"); then
    printf '%s\n' "$resp" | jq .
else
    status=$?
    printf '%s\n' "$resp" | jq . 2>/dev/null || printf '%s\n' "$resp" >&2
    exit "$status"
fi

#!/usr/bin/env bash
#
# propose-auto-approve-rule — ask the owner to auto-approve one NARROW
# category of agent edit proposal, over HTTPS.
#
# Calls the propose_auto_approve_rule RPC, which switches to the `claude`
# role and inserts one pending auto_approve_rules row. Nothing changes until
# the owner approves the request on the Auto approve tab — and even then the
# claude role gains no write: an approved rule just lets the owner's own app
# apply matching pending proposals without a tap, stamping each with the
# rule's id for the tab's history. Categories the owner denied or revoked
# recently refuse server-side; identical open requests dedupe.
#
# Usage:
#   scripts/propose-auto-approve-rule --profile <uuid> \
#       --queue agent_todo_proposals --kind complete --columns day \
#       --target <todo_uuid> --target-label "Morning run" \
#       --rationale "You approved 7 of 7 'complete Morning run' proposals since 2026-08-25, none denied."
#
# Flags: --profile, --queue (agent_map_proposals|agent_todo_proposals),
# --kind (add|update|complete — retire can never auto-approve), --columns
# (comma-separated `after` keys the rule covers, e.g. "rank" or "day") and
# --rationale required. --target pins the rule to one row (the cell/todo an
# update or complete targets; the parent cell / event an add goes into) —
# strongly preferred; --target-label is its human name for the rule card.
#
# Environment (all required; see notes/07-agent-rq-https.md):
#   SUPABASE_URL, SUPABASE_ANON_KEY, CLAUDE_RQ_KEY

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

profile='' queue='' kind='' columns='' target='' target_label='' rationale=''
while [ $# -gt 0 ]; do
    case "$1" in
        --profile)      profile="${2:?}";      shift 2 ;;
        --queue)        queue="${2:?}";        shift 2 ;;
        --kind)         kind="${2:?}";         shift 2 ;;
        --columns)      columns="${2:?}";      shift 2 ;;
        --target)       target="${2:?}";       shift 2 ;;
        --target-label) target_label="${2:?}"; shift 2 ;;
        --rationale)    rationale="${2:?}";    shift 2 ;;
        -h|--help)      sed -n '2,29p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
        *) die "unknown flag: $1" ;;
    esac
done

[ -n "$profile" ] && [ -n "$queue" ] && [ -n "$kind" ] && [ -n "$columns" ] && [ -n "$rationale" ] ||
    die "--profile, --queue, --kind, --columns and --rationale are all required"
case "$queue" in agent_map_proposals|agent_todo_proposals) ;;
    *) die "--queue must be agent_map_proposals or agent_todo_proposals" ;; esac
case "$kind" in add|update|complete) ;;
    *) die "--kind must be add, update or complete — retire never auto-approves" ;; esac

for v in SUPABASE_URL SUPABASE_ANON_KEY CLAUDE_RQ_KEY; do
    [ -n "${!v:-}" ] || die "$v is not set — see notes/07-agent-rq-https.md"
done

body=$(jq -n --arg profile "$profile" --arg queue "$queue" --arg kind "$kind" \
    --arg columns "$columns" --arg target "$target" \
    --arg target_label "$target_label" --arg rationale "$rationale" '
    {_profile_id: $profile, _queue: $queue, _kind: $kind,
     _columns: ($columns | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(. != ""))),
     _rationale: $rationale}
    + (if $target       != "" then {_target_id: $target}          else {} end)
    + (if $target_label != "" then {_target_label: $target_label} else {} end)')

if resp=$(curl -sS --fail-with-body \
    -X POST "${SUPABASE_URL%/}/rest/v1/rpc/propose_auto_approve_rule" \
    -H "apikey: ${SUPABASE_ANON_KEY}" \
    -H "x-claude-rq-key: ${CLAUDE_RQ_KEY}" \
    -H "content-type: application/json" \
    --data "$body"); then
    printf '%s\n' "$resp" | jq .
else
    status=$?
    printf '%s\n' "$resp" | jq . 2>/dev/null || printf '%s\n' "$resp" >&2
    exit "$status"
fi

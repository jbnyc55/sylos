#!/usr/bin/env bash
#
# revise-map-edit — rewrite one flagged goal-map proposal, over HTTPS.
#
# The edit-feedback loop's map write path: calls the revise_map_edit RPC,
# which switches to the `claude` role and updates one agent_map_proposals
# row the owner flagged with Request changes (status changes_requested).
# A revision restates the WHOLE edit — kind, targets, snapshots, rationale —
# and sends the row back to pending for a fresh review; --withdraw instead
# resolves it as withdrawn (the feedback read as "drop the idea"). Only a
# changes_requested row moves, so a replayed call errors rather than
# double-writes. Nothing here touches goal_method_cells.
#
# Usage:
#   scripts/revise-map-edit --id <proposal_uuid> --kind update \
#       --cell <uuid> --goal <uuid> \
#       --before '{"rank": 2}' --after '{"rank": 1}' \
#       --rationale "Revised per feedback: keep the title, only lift the rank."
#   scripts/revise-map-edit --id <proposal_uuid> --withdraw
#
# Flags: --id required. Either --withdraw, or --kind (add|update|retire) and
# --rationale plus the edit's fields, exactly as propose-map-edit takes them:
#   add:    --parent <uuid> (omit for a new top-level goal), --after
#   update: --cell <uuid>, --after (changed fields), --before (their values)
#   retire: --cell <uuid>, --before (at least {"title": ...})
# Omitted fields are cleared, not kept — restate everything the revised edit
# needs, --goal included.
#
# Environment (all required; see notes/07-agent-rq-https.md):
#   SUPABASE_URL, SUPABASE_ANON_KEY, CLAUDE_RQ_KEY

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

id='' kind='' rationale='' cell='' parent='' goal='' before='' after='' withdraw=false
while [ $# -gt 0 ]; do
    case "$1" in
        --id)        id="${2:?}";        shift 2 ;;
        --withdraw)  withdraw=true;      shift ;;
        --kind)      kind="${2:?}";      shift 2 ;;
        --rationale) rationale="${2:?}"; shift 2 ;;
        --cell)      cell="${2:?}";      shift 2 ;;
        --parent)    parent="${2:?}";    shift 2 ;;
        --goal)      goal="${2:?}";      shift 2 ;;
        --before)    before="${2:?}";    shift 2 ;;
        --after)     after="${2:?}";     shift 2 ;;
        -h|--help)   sed -n '2,29p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
        *) die "unknown flag: $1" ;;
    esac
done

[ -n "$id" ] || die "--id is required"
if [ "$withdraw" = false ]; then
    [ -n "$kind" ] && [ -n "$rationale" ] ||
        die "--kind and --rationale are required (or pass --withdraw)"
    case "$kind" in add|update|retire) ;; *) die "--kind must be add, update or retire" ;; esac
fi

for v in SUPABASE_URL SUPABASE_ANON_KEY CLAUDE_RQ_KEY; do
    [ -n "${!v:-}" ] || die "$v is not set — see notes/07-agent-rq-https.md"
done

body=$(jq -n --arg id "$id" --argjson withdraw "$withdraw" \
    --arg kind "$kind" --arg rationale "$rationale" \
    --arg cell "$cell" --arg parent "$parent" --arg goal "$goal" \
    --arg before "$before" --arg after "$after" '
    {_id: $id, _withdraw: $withdraw}
    + (if $kind      != "" then {_kind: $kind}           else {} end)
    + (if $rationale != "" then {_rationale: $rationale} else {} end)
    + (if $cell      != "" then {_cell_id: $cell}        else {} end)
    + (if $parent    != "" then {_parent_id: $parent}    else {} end)
    + (if $goal      != "" then {_goal_id: $goal}        else {} end)
    + (if $before    != "" then {_before: ($before | fromjson)} else {} end)
    + (if $after     != "" then {_after:  ($after  | fromjson)} else {} end)') \
    || die "--before and --after must be valid JSON"

if resp=$(curl -sS --fail-with-body \
    -X POST "${SUPABASE_URL%/}/rest/v1/rpc/revise_map_edit" \
    -H "apikey: ${SUPABASE_ANON_KEY}" \
    -H "x-claude-rq-key: ${CLAUDE_RQ_KEY}" \
    -H "content-type: application/json" \
    --data "$body"); then
    printf '%s\n' "$resp" | jq .
else
    status=$?
    printf '%s\n' "$resp" | jq . 2>/dev/null || printf '%s\n' "$resp" >&2
    exit "$status"
fi

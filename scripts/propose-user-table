#!/usr/bin/env bash
#
# propose-user-table — file one pending user-table proposal, over HTTPS.
#
# Syla's path toward the owner's own tables: calls the propose_user_table
# RPC, which lints the SQL, switches to the `claude` role and inserts one
# pending user_table_proposals row. Nothing executes — the owner reviews
# the SQL on the Inbox card and applies it in the app, where it runs as
# the sandboxed user_tables_owner role. Identical pending DDL dedupes
# server-side, so re-running is safe. The recipe and the required script
# shape (RLS in the same script, owner policies, claude read-only) are in
# the skills/user-tables doc and notes/07-user-tables.md.
#
# Usage:
#   scripts/propose-user-table --profile <uuid> \
#       --title "workouts — from workouts.csv" \
#       --summary "One row per session for the 3,400 workouts you uploaded." \
#       --ddl-file table.sql [--seed-file seed.sql]
#
# Flags: --profile, --title, --summary and --ddl-file required.
#   --ddl-file   the schema change (create/alter/drop table + RLS + policies)
#   --seed-file  optional plain INSERTs applied right after the DDL
#                (keep it under ~2 MB; bigger data enters through the app)
#
# Environment (all required; see notes/03-agent-access.md):
#   SUPABASE_URL, SUPABASE_ANON_KEY, CLAUDE_RQ_KEY

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

profile='' title='' summary='' ddl_file='' seed_file=''
while [ $# -gt 0 ]; do
    case "$1" in
        --profile)   profile="${2:?}";   shift 2 ;;
        --title)     title="${2:?}";     shift 2 ;;
        --summary)   summary="${2:?}";   shift 2 ;;
        --ddl-file)  ddl_file="${2:?}";  shift 2 ;;
        --seed-file) seed_file="${2:?}"; shift 2 ;;
        -h|--help)   sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
        *) die "unknown flag: $1" ;;
    esac
done

[ -n "$profile" ] && [ -n "$title" ] && [ -n "$summary" ] && [ -n "$ddl_file" ] ||
    die "--profile, --title, --summary and --ddl-file are all required"
[ -f "$ddl_file" ] || die "no such file: $ddl_file"
[ -z "$seed_file" ] || [ -f "$seed_file" ] || die "no such file: $seed_file"

for v in SUPABASE_URL SUPABASE_ANON_KEY CLAUDE_RQ_KEY; do
    [ -n "${!v:-}" ] || die "$v is not set — see notes/03-agent-access.md"
done

body=$(jq -n --arg profile "$profile" --arg title "$title" --arg summary "$summary" \
    --rawfile ddl "$ddl_file" \
    '{_profile_id: $profile, _title: $title, _summary: $summary, _ddl_sql: $ddl}')
if [ -n "$seed_file" ]; then
    body=$(printf '%s' "$body" | jq --rawfile seed "$seed_file" '. + {_seed_sql: $seed}')
fi

if resp=$(curl -sS --fail-with-body \
    -X POST "${SUPABASE_URL%/}/rest/v1/rpc/propose_user_table" \
    -H "apikey: ${SUPABASE_ANON_KEY}" \
    -H "x-claude-rq-key: ${CLAUDE_RQ_KEY}" \
    -H "content-type: application/json" \
    --data "$body"); then
    printf '%s\n' "$resp" | jq .
else
    status=$?
    printf '%s\n' "$resp" | jq . 2>/dev/null || printf '%s\n' "$resp" >&2
    exit "$status"
fi

#!/usr/bin/env bash
#
# silo-note — set one jot's silo set and stamp its vetting, over HTTPS.
#
# The siloing routine's write: calls the set_note_silos RPC, which switches
# to the `claude` role, replaces the jot's note_silos rows with exactly the
# given silo ids, and stamps silos_vetted_at = now(). An empty --silos is
# the "read it, nothing fits" outcome: the stamp is still written, so the
# jot is provably vetted rather than merely unplaced. Idempotent.
#
# Usage:
#   scripts/silo-note --note <note-uuid> --silos <silo-uuid>,<silo-uuid>
#   scripts/silo-note --note <note-uuid> --silos ""      # vetted, no silo fits
#
# Flags: both required (--silos may be an empty string).
#
# Environment (all required; see notes/07-agent-rq-https.md):
#   SUPABASE_URL, SUPABASE_ANON_KEY, CLAUDE_RQ_KEY

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

note='' silos='' silos_set=0
while [ $# -gt 0 ]; do
    case "$1" in
        --note)  note="${2:?}"; shift 2 ;;
        --silos) silos="${2-}"; silos_set=1; shift 2 ;;
        -h|--help) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
        *) die "unknown flag: $1" ;;
    esac
done

[ -n "$note" ] && [ "$silos_set" = 1 ] || die "--note and --silos are required"

for v in SUPABASE_URL SUPABASE_ANON_KEY CLAUDE_RQ_KEY; do
    [ -n "${!v:-}" ] || die "$v is not set — see notes/07-agent-rq-https.md"
done

body=$(jq -n --arg note "$note" --arg silos "$silos" '
    {_note_id: $note,
     _silo_ids: ($silos | split(",") | map(select(length > 0)))}')

if resp=$(curl -sS --fail-with-body \
    -X POST "${SUPABASE_URL%/}/rest/v1/rpc/set_note_silos" \
    -H "apikey: ${SUPABASE_ANON_KEY}" \
    -H "x-claude-rq-key: ${CLAUDE_RQ_KEY}" \
    -H "content-type: application/json" \
    --data "$body"); then
    printf '%s\n' "$resp" | jq .
else
    status=$?
    printf '%s\n' "$resp" | jq . 2>/dev/null || printf '%s\n' "$resp" >&2
    exit "$status"
fi

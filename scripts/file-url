#!/usr/bin/env bash
#
# file-url — a short-lived signed link for a stored file, over HTTPS.
#
# Media drops (chute photos, files, voice memos — any uploads row) live
# in the private uploads bucket, which SQL cannot reach. This posts the
# upload id to the claude-file edge function with the rq key and prints
# {url, path, mime, bytes, expires_in} — download the url and look at
# the file before filing it. The link expires in minutes.
#
# Usage:
#   scripts/file-url <upload_id>
#   curl -sL -o /tmp/drop "$(scripts/file-url <upload_id> | jq -r .url)"
#
# Environment (all required; see notes/07-agent-rq-https.md):
#   SUPABASE_URL, SUPABASE_ANON_KEY, CLAUDE_RQ_KEY

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

case "${1:-}" in
    -h|--help|'') sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac

upload_id=$1

for v in SUPABASE_URL SUPABASE_ANON_KEY CLAUDE_RQ_KEY; do
    [ -n "${!v:-}" ] || die "$v is not set — see notes/07-agent-rq-https.md"
done

if resp=$(curl -sS --fail-with-body \
    -X POST "${SUPABASE_URL%/}/functions/v1/claude-file" \
    -H "apikey: ${SUPABASE_ANON_KEY}" \
    -H "x-claude-rq-key: ${CLAUDE_RQ_KEY}" \
    -H "content-type: application/json" \
    --data "{\"upload_id\": \"${upload_id}\"}"); then
    printf '%s\n' "$resp" | jq .
else
    status=$?
    printf '%s\n' "$resp" | jq . 2>/dev/null || printf '%s\n' "$resp" >&2
    exit "$status"
fi

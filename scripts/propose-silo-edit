#!/usr/bin/env bash
#
# propose-silo-edit — file one whole silo change as an Inbox card, over
# HTTPS.
#
# Calls the propose_approval RPC with kind 'silo_edit', which switches to
# the `claude` role and inserts one pending syla_approvals card. The
# payload is the structured plan the OWNER'S client applies on approve
# (create/find the silo, set defaults, add rules, place whole tables,
# admit followers) — see skills/silo-edits for the shape. Nothing is
# applied by this call.
#
# Usage:
#   scripts/propose-silo-edit --title "<what and why, short>" \
#       --payload '<json object>' [--detail "<the longer why>"] \
#       [--chat <chat-uuid>] [--follower <follower-uuid>]
#
# Flags: --title and --payload required; the payload must be a JSON
# object naming its silo (silo_name or silo_id).
#
# Environment (all required; see notes/03-agent-access.md):
#   SUPABASE_URL, SUPABASE_ANON_KEY, CLAUDE_RQ_KEY

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

title='' detail='' payload='' chat='' follower=''
while [ $# -gt 0 ]; do
    case "$1" in
        --title)    title="${2:?}"; shift 2 ;;
        --detail)   detail="${2:?}"; shift 2 ;;
        --payload)  payload="${2:?}"; shift 2 ;;
        --chat)     chat="${2:?}"; shift 2 ;;
        --follower) follower="${2:?}"; shift 2 ;;
        -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
        *) die "unknown flag: $1" ;;
    esac
done

[ -n "$title" ] && [ -n "$payload" ] || die "--title and --payload are required"

jq -e 'type == "object"' >/dev/null 2>&1 <<<"$payload" \
    || die "--payload must be a JSON object (see skills/silo-edits)"
jq -e '(.silo_name // .silo_id // "") != ""' >/dev/null 2>&1 <<<"$payload" \
    || die "the payload must name its silo (silo_name or silo_id)"

for v in SUPABASE_URL SUPABASE_ANON_KEY CLAUDE_RQ_KEY; do
    [ -n "${!v:-}" ] || die "$v is not set — see notes/03-agent-access.md"
done

body=$(jq -n --arg title "$title" --arg detail "$detail" \
             --arg chat "$chat" --arg follower "$follower" \
             --argjson payload "$payload" '
    {_kind: "silo_edit", _title: $title, _payload: $payload}
    + (if $detail != "" then {_detail: $detail} else {} end)
    + (if $chat != "" then {_chat_id: $chat} else {} end)
    + (if $follower != "" then {_follower_id: $follower} else {} end)')

if resp=$(curl -sS --fail-with-body \
    -X POST "${SUPABASE_URL%/}/rest/v1/rpc/propose_approval" \
    -H "apikey: ${SUPABASE_ANON_KEY}" \
    -H "x-claude-rq-key: ${CLAUDE_RQ_KEY}" \
    -H "content-type: application/json" \
    --data "$body"); then
    printf '%s\n' "$resp" | jq .
else
    status=$?
    printf '%s\n' "$resp" | jq . 2>/dev/null || printf '%s\n' "$resp" >&2
    exit "$status"
fi

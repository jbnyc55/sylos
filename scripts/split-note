#!/usr/bin/env bash
#
# split-note — split one multi-silo jot into sub-notes, over HTTPS.
#
# The siloing routine's other write: calls the split_note RPC, which switches
# to the `claude` role and either creates two or more sub-notes (each on the
# parent's day, placed in its slice of the parent's silos, born vetted) or
# — given an empty array — just stamps split_attempted_at, recording that a
# split was tried and no clean one existed. The parent note is never edited.
#
# Usage:
#   scripts/split-note --note <note-uuid> --subnotes '[
#     {"body": "Lunch out, about 800 kcal.", "silo_ids": ["<calories-uuid>"]},
#     {"body": "Spent $18 on that lunch.",   "silo_ids": ["<money-uuid>"]}
#   ]'
#   scripts/split-note --note <note-uuid> --subnotes '[]'   # no clean split
#
# Flags: both required. --subnotes must be a JSON array with zero or 2+
# elements — a one-element "split" is no split at all.
#
# Environment (all required; see notes/07-agent-rq-https.md):
#   SUPABASE_URL, SUPABASE_ANON_KEY, CLAUDE_RQ_KEY

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

note='' subnotes=''
while [ $# -gt 0 ]; do
    case "$1" in
        --note)     note="${2:?}";     shift 2 ;;
        --subnotes) subnotes="${2:?}"; shift 2 ;;
        -h|--help) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
        *) die "unknown flag: $1" ;;
    esac
done

[ -n "$note" ] && [ -n "$subnotes" ] || die "--note and --subnotes are required"

for v in SUPABASE_URL SUPABASE_ANON_KEY CLAUDE_RQ_KEY; do
    [ -n "${!v:-}" ] || die "$v is not set — see notes/07-agent-rq-https.md"
done

body=$(jq -n --arg note "$note" --arg subnotes "$subnotes" '
    {_note_id: $note, _subnotes: ($subnotes | fromjson)}') \
    || die "--subnotes must be valid JSON"

if resp=$(curl -sS --fail-with-body \
    -X POST "${SUPABASE_URL%/}/rest/v1/rpc/split_note" \
    -H "apikey: ${SUPABASE_ANON_KEY}" \
    -H "x-claude-rq-key: ${CLAUDE_RQ_KEY}" \
    -H "content-type: application/json" \
    --data "$body"); then
    printf '%s\n' "$resp" | jq .
else
    status=$?
    printf '%s\n' "$resp" | jq . 2>/dev/null || printf '%s\n' "$resp" >&2
    exit "$status"
fi

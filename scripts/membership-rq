#!/usr/bin/env bash
#
# membership-rq — read-only SQL against a friend's database, as this owner.
#
# A membership is another Sylos database where this database's owner
# holds a member token (the memberships table — skills/memberships).
# This script names the friend and ships one statement to THEIR
# member_rq — through your own project's membership-relay, so the call
# needs no network allowance and the token stays home. You see exactly
# what their silos grant this owner; a refusal means their owner didn't
# share that.
#
# Usage:
#   scripts/membership-rq alex "select lat, lng, pinged_at from location_pings order by pinged_at desc limit 1"
#   scripts/membership-rq alex - <<'SQL'      # stdin form; avoids shell-quoting pain
#   select id, body, created_at from manual_notes order by created_at desc limit 5
#   SQL
#
# Contract at their end: one statement, no trailing semicolon, name your
# columns (`select *` is refused), valid inside a FROM subquery — the
# server wraps it and returns a JSON array.
#
# Environment (all required — the same trio scripts/rq uses):
#   SUPABASE_URL        https://<project-ref>.supabase.co
#   SUPABASE_ANON_KEY   the anon / publishable key (client-public)
#   CLAUDE_RQ_KEY       matches Vault secret claude_rq_key

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

if [ $# -lt 2 ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
fi

for v in SUPABASE_URL SUPABASE_ANON_KEY CLAUDE_RQ_KEY; do
    [ -n "${!v:-}" ] || die "$v is not set — see notes/03-agent-access.md"
done

friend_name="$1"; shift

# Every call goes through YOUR project's membership-relay: it looks the
# friend's credentials up and makes the call — the token never comes here,
# and the session needs no network allowance for the friend's host.
relay() { # $1 = json body
    local resp status
    if resp=$(curl -sS --fail-with-body \
        -X POST "${SUPABASE_URL%/}/functions/v1/membership-relay" \
        -H "apikey: ${SUPABASE_ANON_KEY}" \
        -H "Authorization: Bearer ${SUPABASE_ANON_KEY}" \
        -H "x-claude-rq-key: ${CLAUDE_RQ_KEY}" \
        -H "content-type: application/json" \
        --data "$1"); then
        printf '%s\n' "$resp" | jq .
    else
        status=$?
        printf '%s\n' "$resp" | jq . 2>/dev/null || printf '%s\n' "$resp" >&2
        exit "$status"
    fi
}

if [ "$1" = "-" ]; then q=$(cat); else q="$*"; fi
q="$(printf '%s' "$q" | sed -e 's/[[:space:];]*$//')"
[ -n "$q" ] || die "empty query"

relay "$(jq -n --arg name "$friend_name" --arg q "$q" '{name: $name, kind: "rq", q: $q}')"

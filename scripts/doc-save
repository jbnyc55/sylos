#!/usr/bin/env bash
#
# doc-save — create or replace one doc, over HTTPS.
#
# The docs skill's write: calls the save_doc RPC, which switches to the
# `claude` role and upserts the doc by path. The row_edits trigger captures
# the before/after images server-side, so every save is undoable regardless
# of what this script does. Idempotent: re-saving identical content is an
# update that changes nothing but the log.
#
# Usage:
#   scripts/doc-save --path <a/b/c> --title <title> --html-file <file>
#   scripts/doc-save --path <a/b/c> --title <title> --html-file -   # stdin
#
# Flags: all required. The html must be a complete self-contained document
# (leading <!doctype html>) — the database refuses fragments.
#
# Environment (all required; see notes/07-agent-rq-https.md):
#   SUPABASE_URL, SUPABASE_ANON_KEY, CLAUDE_RQ_KEY

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

path='' title='' html_file=''
while [ $# -gt 0 ]; do
    case "$1" in
        --path)      path="${2:?}"; shift 2 ;;
        --title)     title="${2:?}"; shift 2 ;;
        --html-file) html_file="${2:?}"; shift 2 ;;
        -h|--help) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
        *) die "unknown flag: $1" ;;
    esac
done

[ -n "$path" ] && [ -n "$title" ] && [ -n "$html_file" ] \
    || die "--path, --title and --html-file are required"

for v in SUPABASE_URL SUPABASE_ANON_KEY CLAUDE_RQ_KEY; do
    [ -n "${!v:-}" ] || die "$v is not set — see notes/07-agent-rq-https.md"
done

# The html goes through files, not argv — a full page can exceed ARG_MAX.
tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

if [ "$html_file" = "-" ]; then
    cat > "$tmpdir/page.html"
else
    [ -r "$html_file" ] || die "cannot read $html_file"
    cat "$html_file" > "$tmpdir/page.html"
fi

jq -n --arg path "$path" --arg title "$title" --rawfile html "$tmpdir/page.html" \
    '{_path: $path, _title: $title, _html: $html}' > "$tmpdir/body.json"

if resp=$(curl -sS --fail-with-body \
    -X POST "${SUPABASE_URL%/}/rest/v1/rpc/save_doc" \
    -H "apikey: ${SUPABASE_ANON_KEY}" \
    -H "x-claude-rq-key: ${CLAUDE_RQ_KEY}" \
    -H "content-type: application/json" \
    --data @"$tmpdir/body.json"); then
    printf '%s\n' "$resp" | jq .
else
    status=$?
    printf '%s\n' "$resp" | jq . 2>/dev/null || printf '%s\n' "$resp" >&2
    exit "$status"
fi

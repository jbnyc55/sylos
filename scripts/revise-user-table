#!/usr/bin/env bash
#
# revise-user-table — rework or withdraw one flagged/failed table proposal.
#
# Two rows land back with Syla: a card the owner flagged with feedback
# (status changes_requested) and an apply that errored (status failed, the
# database's error on the row). Either way, calls the revise_user_table
# RPC: a revision restates the whole proposal (title, summary, DDL, seed)
# and returns it to pending for another look; --withdraw resolves it
# instead. Only those two statuses move, so replaying is a no-op error
# rather than a double-write.
#
# Usage:
#   scripts/revise-user-table --id <uuid> \
#       --title "workouts — from workouts.csv" \
#       --summary "Same table, minutes now nullable per your note." \
#       --ddl-file table.sql [--seed-file seed.sql]
#   scripts/revise-user-table --id <uuid> --withdraw
#
# Environment (all required; see notes/03-agent-access.md):
#   SUPABASE_URL, SUPABASE_ANON_KEY, CLAUDE_RQ_KEY

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

id='' title='' summary='' ddl_file='' seed_file='' withdraw=false
while [ $# -gt 0 ]; do
    case "$1" in
        --id)        id="${2:?}";        shift 2 ;;
        --title)     title="${2:?}";     shift 2 ;;
        --summary)   summary="${2:?}";   shift 2 ;;
        --ddl-file)  ddl_file="${2:?}";  shift 2 ;;
        --seed-file) seed_file="${2:?}"; shift 2 ;;
        --withdraw)  withdraw=true;      shift ;;
        -h|--help)   sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
        *) die "unknown flag: $1" ;;
    esac
done

[ -n "$id" ] || die "--id is required"
if ! $withdraw; then
    [ -n "$title" ] && [ -n "$summary" ] && [ -n "$ddl_file" ] ||
        die "a revision restates the whole proposal: --title, --summary and --ddl-file (or pass --withdraw)"
    [ -f "$ddl_file" ] || die "no such file: $ddl_file"
    [ -z "$seed_file" ] || [ -f "$seed_file" ] || die "no such file: $seed_file"
fi

for v in SUPABASE_URL SUPABASE_ANON_KEY CLAUDE_RQ_KEY; do
    [ -n "${!v:-}" ] || die "$v is not set — see notes/03-agent-access.md"
done

if $withdraw; then
    body=$(jq -n --arg id "$id" '{_id: $id, _withdraw: true}')
else
    body=$(jq -n --arg id "$id" --arg title "$title" --arg summary "$summary" \
        --rawfile ddl "$ddl_file" \
        '{_id: $id, _title: $title, _summary: $summary, _ddl_sql: $ddl}')
    if [ -n "$seed_file" ]; then
        body=$(printf '%s' "$body" | jq --rawfile seed "$seed_file" '. + {_seed_sql: $seed}')
    fi
fi

if resp=$(curl -sS --fail-with-body \
    -X POST "${SUPABASE_URL%/}/rest/v1/rpc/revise_user_table" \
    -H "apikey: ${SUPABASE_ANON_KEY}" \
    -H "x-claude-rq-key: ${CLAUDE_RQ_KEY}" \
    -H "content-type: application/json" \
    --data "$body"); then
    printf '%s\n' "$resp" | jq .
else
    status=$?
    printf '%s\n' "$resp" | jq . 2>/dev/null || printf '%s\n' "$resp" >&2
    exit "$status"
fi

#!/usr/bin/env bash
#
# membership-edit — propose a change to a friend's database, or read the rulings.
#
# You never write to a friend's database. This files an EDIT PROPOSAL in
# their member_edit_requests — free text their owner sees in their inbox
# and applies or declines personally, exactly the courtesy your own
# members get here. It works only if one of the silos your owner holds
# there has "propose edits" on; a refusal means it doesn't. Every call
# goes through your own project's membership-relay.
#
# Find the name with scripts/membership-list (case doesn't matter).
#
# Usage:
#   scripts/membership-edit alex "the dentist on Sep 27 is at 3pm, not 2pm"
#   scripts/membership-edit alex -           # stdin form for longer proposals
#   scripts/membership-edit alex --list      # your proposals there, newest first
#
# Environment (all required — the same trio scripts/rq uses):
#   SUPABASE_URL        https://<project-ref>.supabase.co
#   SUPABASE_ANON_KEY   the anon / publishable key (client-public)
#   CLAUDE_RQ_KEY       matches Vault secret claude_rq_key

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

if [ $# -lt 2 ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
fi

for v in SUPABASE_URL SUPABASE_ANON_KEY CLAUDE_RQ_KEY; do
    [ -n "${!v:-}" ] || die "$v is not set — see notes/03-agent-access.md"
done

friend_name="$1"; shift

# Every call goes through YOUR project's membership-relay: it looks the
# friend's credentials up and makes the call — the token never comes here,
# and the session needs no network allowance for the friend's host.
relay() { # $1 = json body
    local resp status
    if resp=$(curl -sS --fail-with-body \
        -X POST "${SUPABASE_URL%/}/functions/v1/membership-relay" \
        -H "apikey: ${SUPABASE_ANON_KEY}" \
        -H "Authorization: Bearer ${SUPABASE_ANON_KEY}" \
        -H "x-claude-rq-key: ${CLAUDE_RQ_KEY}" \
        -H "content-type: application/json" \
        --data "$1"); then
        printf '%s\n' "$resp" | jq .
    else
        status=$?
        printf '%s\n' "$resp" | jq . 2>/dev/null || printf '%s\n' "$resp" >&2
        exit "$status"
    fi
}

if [ "$1" = "--list" ]; then
    q="select id, proposal, status, response, created_at, resolved_at from member_edit_requests order by created_at desc"
    relay "$(jq -n --arg name "$friend_name" --arg q "$q" '{name: $name, kind: "rq", q: $q}')"
    exit 0
fi

if [ "$1" = "-" ]; then proposal=$(cat); else proposal="$*"; fi
[ -n "$(printf '%s' "$proposal" | tr -d '[:space:]')" ] || die "empty proposal"

relay "$(jq -n --arg name "$friend_name" --arg p "$proposal" '{name: $name, kind: "edit", proposal: $p}')"

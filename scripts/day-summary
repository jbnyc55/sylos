#!/usr/bin/env bash
#
# day-summary — upsert one day_summary row, over HTTPS.
#
# The daily routine's write: calls the upsert_day_summary RPC, which switches
# to the `claude` role and upserts on (profile_id, day). The role's grant is
# column-scoped (insert profile_id/day/stats, update stats only) and there is
# no delete, so this is the only thing the transport can do to the table.
#
# Usage:
#   scripts/day-summary --profile <uuid> --day 2026-08-27 --stats '{
#     "insights": "Dinner drove the calorie overage; the rest was on target.",
#     "calories": {"value": 2150, "description": "Estimated calories consumed"},
#     "spend":    {"value": 63.2, "description": "Total money out"}
#   }'
#
# Flags: all three required. --stats must be a JSON object; re-running a day
# replaces its stats (idempotent).
#
# Environment (all required; see notes/07-agent-rq-https.md):
#   SUPABASE_URL, SUPABASE_ANON_KEY, CLAUDE_RQ_KEY

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

profile='' day='' stats=''
while [ $# -gt 0 ]; do
    case "$1" in
        --profile) profile="${2:?}"; shift 2 ;;
        --day)     day="${2:?}";     shift 2 ;;
        --stats)   stats="${2:?}";   shift 2 ;;
        -h|--help) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
        *) die "unknown flag: $1" ;;
    esac
done

[ -n "$profile" ] && [ -n "$day" ] && [ -n "$stats" ] ||
    die "--profile, --day and --stats are all required"

for v in SUPABASE_URL SUPABASE_ANON_KEY CLAUDE_RQ_KEY; do
    [ -n "${!v:-}" ] || die "$v is not set — see notes/07-agent-rq-https.md"
done

body=$(jq -n --arg profile "$profile" --arg day "$day" --arg stats "$stats" '
    {_profile_id: $profile, _day: $day, _stats: ($stats | fromjson)}') \
    || die "--stats must be valid JSON"

if resp=$(curl -sS --fail-with-body \
    -X POST "${SUPABASE_URL%/}/rest/v1/rpc/upsert_day_summary" \
    -H "apikey: ${SUPABASE_ANON_KEY}" \
    -H "x-claude-rq-key: ${CLAUDE_RQ_KEY}" \
    -H "content-type: application/json" \
    --data "$body"); then
    printf '%s\n' "$resp" | jq .
else
    status=$?
    printf '%s\n' "$resp" | jq . 2>/dev/null || printf '%s\n' "$resp" >&2
    exit "$status"
fi

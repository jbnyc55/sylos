#!/usr/bin/env bash
#
# peer-prompt — queue a prompt at a peer's database, or read your answers.
#
# The syla-to-syla channel: where peer-rq runs SQL directly (for what the
# peer's silos grant), this queues a free-text prompt in THEIR
# member_prompt_requests for their owner — or their Syla, if they automate
# it — to answer in their own time. Poll with --list; pending means
# pending, not failed.
#
# Usage:
#   scripts/peer-prompt alex "can you do dinner on Friday?"
#   scripts/peer-prompt alex -            # stdin form for longer prompts
#   scripts/peer-prompt alex --list       # your requests there, newest first
#
# Environment (all required — the same trio scripts/rq uses, for the
# LOCAL lookup; the peer's credentials come from the peers row):
#   SUPABASE_URL        https://<project-ref>.supabase.co
#   SUPABASE_ANON_KEY   the anon / publishable key (client-public)
#   CLAUDE_RQ_KEY       matches Vault secret claude_rq_key

set -euo pipefail

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

if [ $# -lt 2 ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
fi

for v in SUPABASE_URL SUPABASE_ANON_KEY CLAUDE_RQ_KEY; do
    [ -n "${!v:-}" ] || die "$v is not set — see notes/03-agent-access.md"
done

script_dir="$(cd "$(dirname "$0")" && pwd)"
peer_name="$1"; shift

# Resolve the peer locally. Never echo member_token beyond these calls.
peer_json=$("$script_dir/rq" - <<SQL
select project_url, anon_key, member_token
from peers where name = '$(printf '%s' "$peer_name" | sed "s/'/''/g")'
SQL
)
count=$(printf '%s' "$peer_json" | jq 'length')
[ "$count" = "1" ] || die "no peer named '$peer_name' — scripts/rq \"select name from peers order by name\""

peer_url=$(printf '%s' "$peer_json" | jq -r '.[0].project_url')
peer_key=$(printf '%s' "$peer_json" | jq -r '.[0].anon_key')
peer_tok=$(printf '%s' "$peer_json" | jq -r '.[0].member_token')

post() { # $1 = rpc name, $2 = json body
    local resp status
    if resp=$(curl -sS --fail-with-body \
        -X POST "${peer_url%/}/rest/v1/rpc/$1" \
        -H "apikey: ${peer_key}" \
        -H "content-type: application/json" \
        --data "$2"); then
        printf '%s\n' "$resp" | jq .
    else
        status=$?
        printf '%s\n' "$resp" | jq . 2>/dev/null || printf '%s\n' "$resp" >&2
        exit "$status"
    fi
}

if [ "$1" = "--list" ]; then
    q="select id, prompt, status, response, created_at, answered_at
       from member_prompt_requests order by created_at desc"
    post member_rq "$(jq -n --arg token "$peer_tok" --arg q "$q" '{_token: $token, q: $q}')"
    exit 0
fi

if [ "$1" = "-" ]; then prompt=$(cat); else prompt="$*"; fi
[ -n "$(printf '%s' "$prompt" | tr -d '[:space:]')" ] || die "empty prompt"

post member_submit_prompt \
    "$(jq -n --arg token "$peer_tok" --arg p "$prompt" '{_token: $token, _prompt: $p}')"
